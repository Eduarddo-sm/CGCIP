# Aplicacao Negocial

# Padrao atual com SQLite local.
DATABASE_URL=sqlite:///database/negocial.sqlite3

# Futuro PostgreSQL na intranet.
# DATABASE_URL=postgresql+psycopg://projeto_user:SENHA@127.0.0.1:5432/projeto_negocial

# Gere uma chave aleatoria com pelo menos 48 caracteres.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=negocial_token
# Use true quando o sistema for servido por HTTPS.
SECURE_COOKIES=false
# Usados somente no primeiro bootstrap, quando ainda nao existe nenhum usuario.
# A senha deve ter pelo menos 12 caracteres e nao pode ser uma senha conhecida.
ADMIN_USERNAME=
ADMIN_PASSWORD=
