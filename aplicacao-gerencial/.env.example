# Aplicacao Gerencial

# Producao: PostgreSQL na intranet. Use DNS local para nao depender de IP dinamico.
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@SERVIDOR:5432/projeto_negocial

# Desenvolvimento isolado e testes manuais:
# DATABASE_URL=sqlite:///data/app.sqlite3

# Opcionais.
# NEGOCIADORES_DATA_DIR=data
# NEGOCIADORES_UI_DIR=ui
# NEGOCIADORES_LOG_LEVEL=INFO
# SECURE_COOKIES=false
# Compartilhe a mesma chave entre instancias. Gere com Fernet.generate_key().
# SPREADSHEET_CREDENTIAL_KEY=
# NEGOCIADORES_BACKUP_INTERVAL_HOURS=24
# NEGOCIADORES_BACKUP_INITIAL_DELAY_SECONDS=300
# GERENCIAL_DB_MONITOR_INTERVAL_SECONDS=300
# GERENCIAL_DB_HEARTBEAT_WARNING_SECONDS=900
# GERENCIAL_DB_CONNECTION_WARNING_PERCENT=75
# GERENCIAL_DB_CACHE_WARNING_PERCENT=95
# GERENCIAL_DB_LONG_TRANSACTION_SECONDS=60
# GERENCIAL_DB_DEAD_TUPLE_WARNING_PERCENT=20
# GERENCIAL_DB_POOL_MIN=4
# GERENCIAL_DB_POOL_MAX=16
# GERENCIAL_DB_POOL_TIMEOUT=10

# Usados somente quando o banco ainda nao possui nenhum usuario.
# Remova as variaveis depois do primeiro acesso.
# GERENCIAL_BOOTSTRAP_ADMIN_USERNAME=
# GERENCIAL_BOOTSTRAP_ADMIN_PASSWORD=
